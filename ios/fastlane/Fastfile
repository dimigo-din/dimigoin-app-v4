require "yaml"

opt_out_usage
default_platform(:ios)

platform :ios do
  before_all do
    setup_ci if ENV['CI']

    app_store_connect_api_key(
      key_id: ENV["APPSTORECONNECT_API_KEY_ID"],
      issuer_id: ENV["APPSTORECONNECT_API_ISSUER_ID"],
      key_content: ENV["APPSTORECONNECT_API_KEY"]
    )
  end

  private_lane :create_shorebird_release do
    match(
      type: "appstore",
      readonly: true
    )

    project_root = File.expand_path("../..", __dir__)
    pubspec = YAML.safe_load(File.read(File.join(project_root, "pubspec.yaml")))
    flutter_version = pubspec.dig("environment", "flutter").to_s
    UI.user_error!("Flutter version is not pinned in pubspec.yaml") if flutter_version.empty?

    shorebird_release(
      platform: "ios",
      args: "--flutter-version=#{flutter_version} --export-method=app-store"
    )
  end

  private_lane :upload_shorebird_dsyms do
    project_root = File.expand_path("../..", __dir__)
    runner_dsym = Dir[File.join(project_root, "build/ios/**/*.xcarchive/dSYMs/Runner.app.dSYM")].first ||
                  Dir[File.join(project_root, "build/ios/**/Runner.app.dSYM")].first
    UI.user_error!("Runner.app.dSYM not found under build/ios") unless runner_dsym

    dsyms_directory = File.dirname(runner_dsym)
    upload_symbols = File.join(project_root, "ios/Pods/FirebaseCrashlytics/upload-symbols")
    google_service_info = File.join(project_root, "ios/Runner/GoogleService-Info.plist")

    sh("dwarfdump", "--uuid", runner_dsym)
    sh(
      upload_symbols,
      "-gsp", google_service_info,
      "-p", "ios",
      dsyms_directory
    )
  end

  desc "Deploy beta build to TestFlight"
  lane :beta do
    create_shorebird_release
    upload_shorebird_dsyms

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Deploy production build to App Store"
  lane :prod do
    create_shorebird_release
    upload_shorebird_dsyms

    upload_to_app_store(
      force: true,
      submit_for_review: false,
      automatic_release: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
